rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function emailNormalizado() {
      return request.auth.token.email.lower();
    }

    function estaAutorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/authorizedUsers/$(emailNormalizado()))
        && get(/databases/$(database)/documents/authorizedUsers/$(emailNormalizado())).data.active == true;
    }

    function ehAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lista branca: só leitura do próprio documento (pelo app); escrita reservada a admins/Admin SDK.
    match /authorizedUsers/{email} {
      allow read: if request.auth != null && emailNormalizado() == email;
      allow write: if ehAdmin();
    }

    // Documento de administrador: nunca editável a partir do cliente.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /requisicoes/{pedidoId} {

      allow read: if ehAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if estaAutorizado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == emailNormalizado()
        && request.resource.data.estado == "Pendente"
        && request.resource.data.equipamento is string
        && request.resource.data.dataPedido is string
        && request.resource.data.devolucaoPrevista is string
        && request.resource.data.devolucaoPrevista >= request.resource.data.dataPedido
        && request.resource.data.observacoes is string
        && request.resource.data.observacoes.size() <= 500;

      // Alunos não editam nem apagam; só administradores alteram o estado.
      allow update: if ehAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.equipamento == resource.data.equipamento;

      allow delete: if ehAdmin();
    }

    // Coleção futura de inventário — fora do âmbito desta versão.
    match /equipamentos/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
